# Copy this file to .env and fill in real values. .env is git-ignored.
# No spaces around '=', no leading spaces before the key.

# --- Shared/default credentials (used when a device has no per-device override) ---
NET_USERNAME=admin
NET_PASSWORD=changeme
NET_SECRET=changeme

# --- Per-device enable secrets ---
# One line per device. The variable name is referenced by 'secret_env' in
# rack_inventory.yaml. Naming convention: SECRET_<device-name-with-underscores>.
# Example:
# SECRET_SW_SITE_01=enableSecretForSwitch1
# SECRET_SW_SITE_02=enableSecretForSwitch2
